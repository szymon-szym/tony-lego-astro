---
import "@assets/styles/global.css";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import brics from "../assets/img/brics.jpg";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => a.data.date < b.data.date ? 0 : 1);
---

<PageLayout>
	<main class="flex-grow">
		<section class="relative flex min-h-[60vh] items-center justify-center overflow-hidden">
			<div class="absolute inset-0 bg-gradient-to-b from-indigo-950/40 via-black to-black" />
			<div class="relative z-10 flex flex-col items-center gap-8 px-6 py-20 text-center">
				<Image class="h-40 w-40 rounded-full ring-2 ring-white/20 shadow-2xl shadow-indigo-500/20" src={brics} alt="logo of the tony lego" />
				<h1 class="text-7xl font-extrabold tracking-tight text-white">Tony Lego</h1>
				<p class="max-w-2xl text-lg text-gray-300">
					Witaj na mojej stronie, gdzie dzielę się pasją do klocków. Pokażę Wam fajne rzeczy. Bardzo lubię Lego
				</p>
			</div>
		</section>

		<section class="mx-auto max-w-6xl px-6 py-12">
			<h2 class="mb-10 text-3xl font-bold text-white">Ostatnie&nbsp;wpisy</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					sortedPosts.map((post) => (
						<a
							href={"blog/" + post.slug}
							class="group flex flex-col rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition duration-200 hover:border-white/20 hover:bg-white/10 hover:-translate-y-1"
						>
							<h3 class="mb-3 text-xl font-bold text-white group-hover:text-indigo-300 transition-colors">{post.data.title}</h3>
							<p class="mb-4 flex-1 text-sm leading-relaxed text-gray-400">{post.data.description}</p>
							<div class="flex items-center justify-between">
								<span class="text-xs text-gray-500">{`${post.data.date.getDate()}-${post.data.date.getMonth()+1}-${post.data.date.getFullYear()}`}</span>
								<span class="inline-flex items-center text-sm font-medium text-indigo-400 group-hover:text-indigo-300 transition-colors">
									Czytaj
									<svg
										class="ms-1.5 h-4 w-4 transition-transform group-hover:translate-x-1"
										aria-hidden="true"
										xmlns="http://www.w3.org/2000/svg"
										fill="none"
										viewBox="0 0 14 10"
									>
										<path
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M1 5h12m0 0L9 1m4 4L9 9"
										/>
									</svg>
								</span>
							</div>
						</a>
					))
				}
			</div>
		</section>
	</main>
	<div class="flex justify-end py-3">
		<p class="px-4 text-white">Photo by <a href="https://unsplash.com/@designedbyflores?utm_content=creditCopyText&utm_medium=referral&utm_source=unsplash">Omar Flores</a> on <a href="https://unsplash.com/photos/blue-red-and-white-artwork-lQT_bOWtysE?utm_content=creditCopyText&utm_medium=referral&utm_source=unsplash">Unsplash</a>
		</p>
		<p class="px-4 text-white">Tony Lego 2024</p>
	</div>
</PageLayout>
