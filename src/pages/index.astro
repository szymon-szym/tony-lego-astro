---
import "@assets/styles/global.css";
import PageLayout from "@layouts/PageLayout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import brics from "../assets/img/brics.jpg";

const allPosts = (await getCollection("blog")).filter((post) => !post.data.draft);
const sortedPosts = allPosts.sort((a, b) => a.data.date - b.data.date);
---

<PageLayout>
	<main class="flex-grow">
		<section class="relative flex min-h-screen items-center justify-center overflow-hidden">
			<div class="absolute inset-0 bg-tony-50" />
			<div class="relative z-10 flex flex-col items-center gap-6 px-6 py-20 text-center">
				<Image class="h-52 w-52 rounded-full ring-2 ring-tony-300/30 shadow-2xl shadow-tony-300/10" src={brics} alt="logo of the tony lego" />
				<h1 class="text-8xl md:text-9xl font-extrabold tracking-tight text-tony-300">Tony Lego</h1>
				<p class="max-w-3xl text-xl md:text-2xl text-tony-200/80">
					Witaj na mojej stronie, gdzie dzielę się pasją do klocków. Pokażę Wam fajne rzeczy. Bardzo lubię Lego
				</p>
				<a
					href="#wpisy"
					class="mt-8 inline-flex animate-bounce text-tony-300/60 transition-colors hover:text-tony-300"
				>
					<svg class="h-8 w-8" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
					</svg>
				</a>
			</div>
		</section>

		<section id="wpisy" class="mx-auto max-w-6xl px-6 py-12">
			<h2 class="mb-10 text-3xl font-bold text-tony-200">Ostatnie&nbsp;wpisy</h2>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{
					sortedPosts.map((post) => (
						<a
							href={"blog/" + post.slug}
							class="group flex flex-col rounded-lg border border-tony-300/20 bg-transparent p-6 transition duration-200 hover:border-tony-300/60 hover:shadow-[0_0_20px_rgba(102,252,241,0.1)] hover:-translate-y-0.5"
						>
							<h3 class="mb-3 text-xl font-bold text-tony-200 group-hover:text-tony-300 transition-colors">{post.data.title}</h3>
							<p class="mb-4 flex-1 text-sm leading-relaxed text-tony-200/60">{post.data.description}</p>
							<div class="flex items-center justify-between">
								<span class="text-xs text-tony-200/40">{post.data.date.toLocaleDateString("pl-PL", { day: "2-digit", month: "2-digit", year: "numeric" })}</span>
								<span class="inline-flex items-center rounded border border-tony-300/30 px-4 py-1.5 text-sm font-medium tracking-wide text-tony-300 transition-colors group-hover:border-tony-300/60 group-hover:shadow-[0_0_10px_rgba(102,252,241,0.15)]">
									Czytaj
									<svg
										class="ms-1.5 h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
										aria-hidden="true"
										xmlns="http://www.w3.org/2000/svg"
										fill="none"
										viewBox="0 0 14 10"
									>
										<path
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M1 5h12m0 0L9 1m4 4L9 9"
										/>
									</svg>
								</span>
							</div>
						</a>
					))
				}
			</div>
		</section>
	</main>
	<div class="flex justify-end py-3">
		<p class="px-4 text-tony-200/50">Photo by <a href="https://unsplash.com/@designedbyflores?utm_content=creditCopyText&utm_medium=referral&utm_source=unsplash">Omar Flores</a> on <a href="https://unsplash.com/photos/blue-red-and-white-artwork-lQT_bOWtysE?utm_content=creditCopyText&utm_medium=referral&utm_source=unsplash">Unsplash</a>
		</p>
		<p class="px-4 text-tony-200/50">Tony Lego 2024</p>
	</div>
</PageLayout>
